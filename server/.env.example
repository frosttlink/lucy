NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://lucy:lucy@localhost:5432/lucy?sslmode=disable
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
CORS_ORIGIN=*
# Caminho do interpretador Python usado pelo TTS (padrão: python3).
# No Docker é apontado para a venv com edge-tts instalado.
TTS_PYTHON=python3
# Modelo do Groq usado no chat de texto (tem cota TPD própria).
GROQ_MODEL=openai/gpt-oss-20b
# Modelo usado no modo voz (respostas curtas, natural).
GROQ_VOICE_MODEL=openai/gpt-oss-120b
# Limite de tokens de saída por resposta de voz (economiza cota).
GROQ_VOICE_MAX_TOKENS=256
