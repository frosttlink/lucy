{
  "name": "lucy-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write",
